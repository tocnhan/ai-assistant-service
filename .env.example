# Copy this file to .env and fill in your own values
# cp .env.example .env

APP_ENV=development
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=ai_db

# Admin connection (used for migrations / role & grant management)
DATABASE_ADMIN_URL=postgresql://ai_admin:change-this-password@127.0.0.1/ai_db
# App connection (used at runtime, least-privilege role)
DATABASE_URL=postgresql+asyncpg://ai_app:change-this-password@127.0.0.1/ai_db

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────
HMAC_SECRET=change-this-in-production

# ── LLM Providers (fill in only the ones you use) ────────────────────────
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
DEEPSEEK_API_KEY=your-deepseek-key
GROQ_API_KEY=your-groq-key

# ── Misc ──────────────────────────────────────────────────────────────────
BE_PUBLIC_BASE_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Observability (Langfuse tracing) ─────────────────────────────────────
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
